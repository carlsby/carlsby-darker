{
  "name": "carlsby-darker-theme",
  "displayName": "Carlsby Darker",
  "description": "A dark theme tailored for Carlsby.",
  "publisher": "Carlsby",
  "version": "0.12.2",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "vscode",
    "theme",
    "dark",
    "carlsby",
    "yellow",
    "green"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/carlsby/carlsby-dark-theme.git"
  },
  "contributes": {
    "themes": [
      {
        "label": "Carlsby Darker",
        "uiTheme": "vs-dark",
        "path": "./themes/Carlsby Darker-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "editor.fontFamily": "'Cascadia Code', 'Cascadia Mono', Consolas, monospace",
      "editor.fontSize": 15,
      "editor.lineHeight": 25,
      "editor.fontLigatures": true,
      "scm.inputFontFamily": "default"
    }
  },
  "icon": "images/carlsby.png"
}
